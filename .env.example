# ==============================================================================
# TubePilot AI - YouTube AI SaaS Copilot (VidIQ Competitor) Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CACHE
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanal_saas?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH & WEB SECURITY
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-key-min-32-chars-long"

# ------------------------------------------------------------------------------
# 3. GOOGLE & YOUTUBE API CREDENTIALS
# (Google Cloud Console -> APIs & Services -> Credentials)
# Scopes needed:
# - https://www.googleapis.com/auth/userinfo.profile
# - https://www.googleapis.com/auth/userinfo.email
# - https://www.googleapis.com/auth/youtube.readonly
# - https://www.googleapis.com/auth/youtube.force-ssl
# - https://www.googleapis.com/auth/yt-analytics.readonly
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
YOUTUBE_API_KEY="your-google-developer-api-key"

# YouTube WebSub (PubSubHubbub) Webhook verification secret & base domain
WEBSUB_SECRET="generate-a-random-websub-verification-secret"
WEBSUB_CALLBACK_URL="https://your-domain.com/api/webhooks/youtube-websub"

# AES-256-GCM 32-byte hex key to encrypt user OAuth tokens in PostgreSQL
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI API
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="8793624781:AAH50ARJWxJKAS2NTWaeC9ijPaiipTY73P4"
TELEGRAM_BOT_USERNAME="Tuble_Pilot_bot"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="Tuble_Pilot_bot"
# Optional Telegram Webhook URL in production (otherwise long-polling in development)
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/webhooks/telegram"

# ------------------------------------------------------------------------------
# 6. MONETIZATION & PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."

# PayPal REST
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_MODE="sandbox" # or "live"

# Crypto (Cryptomus / NOWPayments)
CRYPTOMUS_MERCHANT_ID="your-cryptomus-merchant-id"
CRYPTOMUS_PAYMENT_KEY="your-cryptomus-payment-key"
