{
  "name": "tubepilot-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,bot\" -c \"magenta,cyan\" \"npm --workspace=@kanal/web run dev\" \"npm --workspace=@kanal/bot run dev\"",
    "bot": "npm --workspace=@kanal/bot run dev",
    "web": "npm --workspace=@kanal/web run dev",
    "dev:web": "npm --workspace=@kanal/web run dev",
    "dev:bot": "npm --workspace=@kanal/bot run dev",
    "dev:worker": "npm --workspace=@kanal/worker run dev",
    "build:extension": "node apps/extension/build.js",
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "build": "turbo run build",
    "start": "next start",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.11.9",
    "typescript": "^5"
  }
}
