{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "LEMON_SQUEEZY_STORE_ID",
    "LEMON_SQUEEZY_PRO_VARIANT_ID",
    "LEMON_SQUEEZY_API_KEY",
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "GEMINI_API_KEY",
    "TELEGRAM_BOT_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    }
  }
}
