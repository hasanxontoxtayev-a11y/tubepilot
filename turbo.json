{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "LEMON_SQUEEZY_STORE_ID",
    "LEMON_SQUEEZY_PRO_VARIANT_ID",
    "LEMON_SQUEEZY_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "LEMON_SQUEEZY_STORE_ID",
        "LEMON_SQUEEZY_PRO_VARIANT_ID",
        "LEMON_SQUEEZY_API_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    }
  }
}
